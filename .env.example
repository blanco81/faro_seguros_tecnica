# ============================================================
# Faro Seguros RAG — configuración (copiar a .env y ajustar)
# Por defecto TODO funciona sin claves ni red (proveedores "fake").
# ============================================================

# --- Proveedores (puertos): "fake" | "openai" | "cloudflare" ---
LLM_PROVIDER=fake
EMBEDDING_PROVIDER=fake

# Opcion A - Cloudflare Workers AI (endpoint OpenAI-compatible, decision D10):
# LLM_PROVIDER=cloudflare
# EMBEDDING_PROVIDER=cloudflare
# LLM_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# EMBEDDING_MODEL=@cf/baai/bge-m3
# CLOUDFLARE_ACCOUNT_ID=tu_account_id
# CLOUDFLARE_API_TOKEN=tu_api_token
# Opcional, solo si se enruta via AI Gateway:
# CLOUDFLARE_GATEWAY_ID=default

# Opcion B - OpenAI (o cualquier endpoint compatible):
# LLM_PROVIDER=openai
# EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- RAG ---
# Similitud mínima para responder; se calibra con el set de evaluación (Fase 3)
REJECTION_THRESHOLD=0.75
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_UPLOAD_MB=20

# --- Observabilidad ---
OTEL_ENABLED=true
# Dentro de docker compose ya está cableado por defecto:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
